import { fileURLToPath } from "node:url";

const options = {
    config: fileURLToPath(new URL("./config/config.js", import.meta.url)),
    "migrations-path": fileURLToPath(new URL("./migrations", import.meta.url)),
};

// sequelize-cli reads this ESM file through require() on Node.js 26.
export { options as "module.exports" };
