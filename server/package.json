{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/bin/www.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/bin/www",
        "mig:generate": "ts-node ./node_modules/sequelize-typescript-migration/dist/cli.js generate --sequelize-path src/setupModels.ts",
        "migration:generate": "sequelize-typescript-migration generate",
        "migration:run": "sequelize-cli db:migrate",
        "migration:revert": "sequelize-cli db:migrate:undo",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "NODE_ENV=test vitest run",
        "test:run": "NODE_ENV=test vitest run"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1022.0",
        "@aws-sdk/s3-presigned-post": "^3.1047.0",
        "@aws-sdk/s3-request-presigner": "^3.1047.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/express-session": "^1.18.2",
        "@types/http-errors": "^2.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.19.15",
        "@types/pg": "^8.20.0",
        "@types/uuid": "^10.0.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "~1.4.4",
        "cors": "^2.8.6",
        "date-fns": "^4.1.0",
        "dayjs": "^1.11.21",
        "debug": "~2.6.9",
        "dotenv": "^16.6.1",
        "ejs": "~2.6.1",
        "express": "^4.22.1",
        "express-rate-limit": "^8.5.1",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "http-errors": "~1.6.3",
        "jsonwebtoken": "^9.0.3",
        "morgan": "~1.9.1",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "pg": "^8.20.0",
        "rate-limit-redis": "^5.0.0",
        "redis": "^5.12.1",
        "sequelize": "^6.37.8",
        "sequelize-auto-migrations": "^1.0.3",
        "sequelize-cli": "^6.6.5",
        "sequelize-mig": "^3.1.3",
        "sequelize-typescript-migration": "^0.0.1-beta.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "xml2js": "^0.6.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@faker-js/faker": "^10.6.0",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.39.5",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.11"
    }
}
